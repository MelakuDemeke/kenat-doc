# Phase 1 API keys, read by lib/api/auth.js.
# Format: comma-separated "key:plan" pairs. Plans: free | pro | business.
# Replace this with a KV/Postgres lookup before charging anyone.
KENAT_API_KEYS="sk_test_local_dev_key:pro,sk_test_free_tier_key:free"

# Upstash Redis — rate limiting and monthly quota counters.
# Without these the limiter falls back to per-instance memory, which is fine for
# local dev and cannot enforce anything in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
