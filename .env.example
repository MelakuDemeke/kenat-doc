# ---------------------------------------------------------------------------
# PUBLIC — safe in the browser and in this repo.
# Firebase web config is an identifier, not a credential; it ships in every
# client bundle by design. Access is controlled by Firestore Security Rules and
# the Auth authorized-domain list, not by hiding these values.
# ---------------------------------------------------------------------------
# Public origin. Every absolute URL derives from this — metadata, JSON-LD, the
# `docs` link in API error responses, and the documentation's examples.
# Change this one value to move domains.
NEXT_PUBLIC_SITE_URL="https://kenat-doc.vercel.app"

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDBHU3KxewypTR2FKkYGXwXr9APdzs3wzo"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="kenat-api.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="kenat-api"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="kenat-api.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="133584234020"
NEXT_PUBLIC_FIREBASE_APP_ID="1:133584234020:web:61a1543f8824fd46755ab1"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-JVM67LK6QY"

# ---------------------------------------------------------------------------
# SECRET — never commit real values, never prefix with NEXT_PUBLIC_.
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle at build time.
# Set these in Vercel > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Firebase Admin SDK. Grants full project access and bypasses all security rules.
# Firebase Console > Project settings > Service accounts > Generate new private key,
# then:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=""

# Comma-separated emails allowed into /console/admin.
ADMIN_EMAILS="melaku.demeke789@gmail.com"

# Upstash Redis — rate limiting, monthly quotas, and the API key mirror the edge
# middleware reads. Without these the limiter falls back to per-instance memory,
# which is fine for local dev and cannot enforce anything in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional dev-only keys, bypassing Firebase entirely: "sk_test_x:pro,sk_test_y:free"
KENAT_API_KEYS=""
